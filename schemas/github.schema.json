{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hassan200503.github.io/schemas/github.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "source", "user", "totals", "technologyLedger", "repos"],
  "properties": {
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "user": {"type": "object"},
    "totals": {"type": "object"},
    "technologyLedger": {"type": "array"},
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "topics", "primaryLanguage", "languageBytes", "url", "homepage", "stars", "forks", "sizeKb", "createdAt", "pushedAt", "archived", "defaultBranch", "license", "technologies", "projectStats", "lastCommit"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "topics": {"type": "array", "items": {"type": "string"}},
          "primaryLanguage": {"type": ["string", "null"]},
          "language": {"type": ["string", "null"]},
          "languageBytes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "languages": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "url": {"type": "string", "format": "uri"},
          "homepage": {"type": ["string", "null"]},
          "stars": {"type": "integer", "minimum": 0},
          "forks": {"type": "integer", "minimum": 0},
          "sizeKb": {"type": "integer", "minimum": 0},
          "createdAt": {"type": ["string", "null"]},
          "pushedAt": {"type": ["string", "null"]},
          "archived": {"type": "boolean"},
          "defaultBranch": {"type": "string", "minLength": 1},
          "license": {"type": ["string", "null"]},
          "technologies": {"type": "array", "items": {"type": "object"}},
          "projectStats": {
            "type": "object",
            "required": ["migrations", "modules", "tests"],
            "properties": {
              "migrations": {"type": "integer", "minimum": 0},
              "modules": {"type": "integer", "minimum": 0},
              "tests": {
                "type": "object",
                "required": ["count", "method"],
                "properties": {
                  "count": {"type": "integer", "minimum": 0},
                  "method": {"type": "string"}
                }
              }
            }
          },
          "lastCommit": {"type": ["object", "null"]}
        }
      }
    }
  }
}
